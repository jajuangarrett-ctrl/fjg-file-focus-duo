{
  "name": "fjg-file-focus-duo",
  "version": "0.1.7",
  "description": "FJG-focused Obsidian file tree with sidebar recent notes and bookmarks.",
  "main": "main.js",
  "scripts": {
    "dev": "rollup -c -w --bundleConfigAsCjs",
    "build": "NODE_ENV=production rollup -c --bundleConfigAsCjs && node scripts/package-local.cjs",
    "test": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser:build": "node tests/browser/build.cjs",
    "test:browser": "node tests/browser/acceptance.cjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "file-tree",
    "bookmarks",
    "recent-notes"
  ],
  "author": "Franklin Garrett",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/common-tags": "1.8.2",
    "@types/node": "^14.14.37",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "babel": "^6.23.0",
    "million": "^2.6.4",
    "obsidian": "^1.4.11",
    "prop-types": "^15.7.2",
    "rollup": "^4.5.2",
    "tslib": "^2.2.0",
    "typescript": "^4.2.4",
    "esbuild": "0.28.1",
    "playwright-core": "1.62.1"
  },
  "dependencies": {
    "@ozntel/local-storage-handler": "1.0.3",
    "common-tags": "1.8.2",
    "dayjs": "1.11.10",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-dropzone": "14.2.3",
    "react-icons": "4.12.0",
    "react-lazy-load": "^4.0.1",
    "recoil": "0.7.7"
  },
  "private": true
}
